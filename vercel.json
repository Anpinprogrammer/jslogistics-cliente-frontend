{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then npm run build:demo; else npm run build; fi",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://js-logistics.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|img/).*)",
      "destination": "/index.html"
    }
  ]
}
