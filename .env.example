# Portal que ven los clientes al iniciar sesión: "mejorado" (diseño nuevo) o "clasico" (igual a la app actual).
VITE_PORTAL_CLIENTE=mejorado
# true = muestra un botón para cambiar entre los dos portales (útil para mostrarle ambos al dueño).
VITE_PERMITIR_CAMBIO_PORTAL=false
# true = usa datos de prueba en el navegador, sin backend.
VITE_DEMO=false
# Solo desarrollo: a dónde manda Vite las llamadas a /api.
VITE_PROXY_API=http://localhost:4000
