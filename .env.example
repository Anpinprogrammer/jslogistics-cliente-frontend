# true = usa datos de prueba en el navegador, sin backend.
VITE_DEMO=false
# URL del backend, sin /api al final (se agrega solo). En Vercel es obligatoria: producción https://api.jslogistics.pro.
# Debe ser un subdominio del mismo dominio del portal para que la cookie funcione en Safari de iPhone.
# Vacía: el portal llama a /api en su mismo dominio (solo sirve en desarrollo, con el proxy de Vite).
VITE_API_URL=
# Solo desarrollo: a dónde manda Vite las llamadas a /api cuando VITE_API_URL está vacía.
VITE_PROXY_API=http://localhost:4000
